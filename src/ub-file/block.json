{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wp-usefull-blocks/ub-file",
	"version": "0.3.0",
	"title": "UB File",
	"category": "media",
	"icon": "media-default",
	"description": "Link to a remote file, optionally mirror it into the media library with Download now, and show link status.",
	"keywords": [ "file", "download", "mirror", "url", "pdf" ],
	"textdomain": "wp-usefull-blocks",
	"attributes": {
		"sourceUrl": {
			"type": "string",
			"default": ""
		},
		"label": {
			"type": "string",
			"default": ""
		},
		"attachmentId": {
			"type": "number",
			"default": 0
		},
		"mirroredFromUrl": {
			"type": "string",
			"default": ""
		},
		"linkBehavior": {
			"type": "string",
			"default": "original-fallback-local",
			"enum": [ "original-fallback-local", "original-only", "local-only" ]
		},
		"lastStatus": {
			"type": "string",
			"default": "unknown"
		},
		"lastChecked": {
			"type": "number",
			"default": 0
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"align": [ "wide", "full" ],
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
